<Window x:Class="PlayView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PlayView.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PlayView" Width="1280" Height="760" MinWidth="900" MinHeight="560"
        Icon="Assets/app.ico"
        Background="{StaticResource Brush.Chrome}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome x:Name="WindowChromeInst" CaptionHeight="34" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleBarRow" Height="34"/>
      <RowDefinition x:Name="MenuBarRow" Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition x:Name="TransportBarRow" Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Custom dark title bar -->
    <Grid x:Name="TitleBarGrid" Background="{StaticResource Brush.Chrome}">
      <TextBlock Text="PlayView" Margin="12,0,0,0" VerticalAlignment="Center"
                 Foreground="{StaticResource Brush.SubText}" FontSize="12"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"/>
        <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize"/>
        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <!-- Menu bar -->
    <Menu x:Name="MenuBar" Grid.Row="1">
      <MenuItem Header="_Media">
        <MenuItem Header="_Open File…" Click="OnOpenFile" InputGestureText="Ctrl+O"/>
        <MenuItem Header="Open _Folder…" Click="OnOpenFolder" InputGestureText="Ctrl+Shift+O"/>
        <Separator/>
        <MenuItem Header="_Close" Click="OnStop"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnClose"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Fullscreen" Click="OnToggleFullscreen" InputGestureText="F"/>
        <MenuItem Header="_Playlist" Click="OnTogglePlaylist"/>
        <MenuItem x:Name="MenuSidebar" Header="S_idebar" Click="OnToggleSidebar"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Open _Settings Folder" Click="OnOpenSettingsFolder"/>
        <MenuItem Header="_Reload Settings" Click="OnReloadSettings"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <!-- Sidebar + content -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="180"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource Brush.Sidebar}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Sidebar" Margin="0,6,0,6"/>
        </ScrollViewer>
      </Border>

      <Grid x:Name="PaneGrid" Grid.Column="1">
        <views:PlayerPane x:Name="PlayerView"/>
        <ContentControl x:Name="OttHost"/>
        <views:MirrorPane x:Name="MirrorView"/>
      </Grid>
    </Grid>

    <!-- Transport bar (VLC-style) -->
    <Border x:Name="TransportBar" Grid.Row="3" Background="{StaticResource Brush.Chrome}"
            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,5,12,7">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Progress / Seek slider and Time / Status -->
        <Grid Grid.Row="0" Margin="0,0,0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Slider x:Name="ProgressSlider" Grid.Column="0" Minimum="0" Maximum="1"
                  VerticalAlignment="Center" Margin="0,0,10,0"
                  PreviewMouseLeftButtonDown="OnProgressDown"
                  PreviewMouseLeftButtonUp="OnProgressUp"/>

          <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00"
                     VerticalAlignment="Center" Foreground="{StaticResource Brush.SubText}" FontSize="12" FontFamily="Consolas, Segoe UI"/>
        </Grid>

        <!-- Row 1: Transport & Control Buttons -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Left: Play, Pause, Stop, Prev/Next, and Phone Remote buttons -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PlayBtn" Style="{StaticResource TransportButton}"
                    Content="▶" FontFamily="Segoe UI Symbol" Click="OnPlay" ToolTip="Play (Space)"/>
            <Button x:Name="PauseBtn" Style="{StaticResource TransportButton}" Margin="4,0,0,0"
                    Content="⏸" FontFamily="Segoe UI Symbol" Click="OnPause" ToolTip="Pause (Space)"/>
            <Button x:Name="StopBtn" Style="{StaticResource TransportButton}" Margin="4,0,0,0"
                    Content="⏹" FontFamily="Segoe UI Symbol" Click="OnStop" ToolTip="Stop"/>
            <Button Style="{StaticResource TransportButton}" Margin="4,0,0,0"
                    Content="⏪" FontFamily="Segoe UI Symbol" Click="OnBack10" ToolTip="Back 10 s (←)"/>
            <Button Style="{StaticResource TransportButton}" Margin="4,0,0,0"
                    Content="⏩" FontFamily="Segoe UI Symbol" Click="OnFwd10" ToolTip="Forward 10 s (→)"/>

            <!-- Phone Remote Buttons (only shown in Mirror mode) -->
            <StackPanel x:Name="PhoneControls" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
              <Rectangle Width="1" Height="16" Fill="{StaticResource Brush.Border}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Button Style="{StaticResource TransportButton}" Margin="2,0,0,0"
                      Content="⬅" Click="OnPhoneBack" ToolTip="Phone Back"/>
              <Button Style="{StaticResource TransportButton}" Margin="2,0,0,0"
                      Content="⌂" FontFamily="Segoe UI Symbol" Click="OnPhoneHome" ToolTip="Phone Home"/>
              <Button Style="{StaticResource TransportButton}" Margin="2,0,0,0"
                      Content="◎" FontFamily="Segoe UI Symbol" Click="OnPhoneTapCenter" ToolTip="Tap Center of Phone Screen"/>
              <Button Style="{StaticResource TransportButton}" Margin="2,0,0,0"
                      Content="⚙" FontFamily="Segoe UI Symbol" Click="OnMirrorSetup" ToolTip="Mirror Setup &amp; Devices"/>
            </StackPanel>
          </StackPanel>

          <!-- Middle: Status / Title -->
          <TextBlock x:Name="StatusLabel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource Brush.SubText}" FontSize="12" TextTrimming="CharacterEllipsis"/>

          <!-- Right: Volume, Playlist, Fullscreen -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="MuteBtn" Style="{StaticResource TransportButton}" Margin="0,0,4,0"
                    Content="🔊" FontSize="13" Click="OnToggleMute" ToolTip="Mute / Unmute (M)"/>
            <Slider x:Name="VolumeSlider" Width="95" Minimum="0" Maximum="125"
                    Value="85" VerticalAlignment="Center" ValueChanged="OnVolumeChanged" ToolTip="Volume (85%)"/>
            <Button Style="{StaticResource TransportButton}" Margin="8,0,0,0"
                    Content="📋" FontFamily="Segoe UI Symbol" Click="OnTogglePlaylist" ToolTip="Files / Playlist (Ctrl+L)"/>
            <Button Style="{StaticResource TransportButton}" Margin="4,0,0,0"
                    Content="⛶" FontFamily="Segoe UI Symbol" Click="OnToggleFullscreen" ToolTip="Fullscreen (F / Double-click)"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>

</Window>
