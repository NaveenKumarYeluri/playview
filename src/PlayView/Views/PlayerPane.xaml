<UserControl x:Class="PlayView.Views.PlayerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">

  <Grid Background="{StaticResource Brush.Pane}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <lvc:VideoView x:Name="Video">
      <Border x:Name="HintBorder" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#B0101010" CornerRadius="6" Padding="26,20">
        <TextBlock x:Name="Hint" Foreground="#DDDDDD" FontSize="14" TextAlignment="Center"
                   Text="Open a video with Media → Open File…&#x0a;or drag &amp; drop files anywhere in the window"/>
      </Border>
    </lvc:VideoView>

    <ListBox x:Name="PlaylistList" Grid.Column="1" Width="250" Visibility="Collapsed"
             Background="{StaticResource Brush.Sidebar}" BorderThickness="1,0,0,0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="OnPlaylistDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>

</UserControl>
