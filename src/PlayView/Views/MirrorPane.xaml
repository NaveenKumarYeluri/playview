<UserControl x:Class="PlayView.Views.MirrorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PlayView.Views"
             xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">

  <Grid Background="{StaticResource Brush.Pane}">

    <!-- ── Setup view ─────────────────────────────────────────────── -->
    <ScrollViewer x:Name="MirrorSetup" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,16" MaxWidth="660" HorizontalAlignment="Left">

        <TextBlock Text="Phone Mirroring" FontSize="18" Foreground="{StaticResource Brush.Text}"/>
        <TextBlock Text="Watch your Android phone on the laptop — as a real VLC-grade video stream (recommended) or via scrcpy."
                   Foreground="{StaticResource Brush.SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <TextBlock Text="PlayView stream (recommended)" Foreground="{StaticResource Brush.Text}" FontSize="14" Margin="0,18,0,6"/>
        <TextBlock Foreground="{StaticResource Brush.SubText}" FontSize="12" TextWrapping="Wrap" LineHeight="19">
          Flawless picture: the phone streams its screen (video + sound) and PlayView plays it with VLC's own engine — same quality as local files.<LineBreak/>
          1. Install the "PlayView Stream" app on the phone (from the CI build artifacts) and open it.<LineBreak/>
          2. Tap "Start streaming" there (accept the capture prompt).<LineBreak/>
          3. Then click one of the buttons below.<LineBreak/>
          Rotate the phone to the orientation you want BEFORE starting.
        </TextBlock>
        <DockPanel Width="440" HorizontalAlignment="Left" Margin="0,10,0,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Content="Stop stream"
                  Click="OnStreamStop" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Content="Start (Wi-Fi)"
                  Click="OnStreamStartWifi" Margin="8,0,0,0" ToolTip="Play the phone's stream over Wi-Fi"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Content="Start (USB)"
                  Click="OnStreamStartUsb" ToolTip="Tunnel the phone's stream over the USB cable"/>
          <TextBox x:Name="StreamIpBox" ToolTip="Phone IP (shown in the PlayView Stream app) — leave empty when using USB"/>
        </DockPanel>

        <Separator Margin="0,18,0,0"/>

        <TextBlock Text="scrcpy window (fallback)" Foreground="{StaticResource Brush.Text}" FontSize="14" Margin="0,12,0,6"/>
        <TextBlock Foreground="{StaticResource Brush.SubText}" FontSize="12" TextWrapping="Wrap" LineHeight="19">
          1. On the phone: Settings → About phone → tap "Build number" 7 times to unlock Developer options.<LineBreak/>
          2. Developer options → enable "USB debugging".<LineBreak/>
          3. Plug the phone in over USB and accept the "Allow USB debugging?" prompt.<LineBreak/>
          4. Click Refresh, select your phone, then click Launch mirror.
        </TextBlock>

        <TextBlock Text="scrcpy not installed? Install it with:  winget install scrcpy" Foreground="{StaticResource Brush.SubText}"
                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <Button x:Name="RefreshBtn" Style="{StaticResource PaneButton}" Content="Refresh devices"
                  Click="OnRefresh"/>
          <Button x:Name="ReturnBtn" Style="{StaticResource PaneButton}" Content="Return to mirror"
                  Click="OnReturnToMirror" Margin="8,0,0,0" Visibility="Collapsed"
                  ToolTip="Show the running mirror again"/>
        </StackPanel>

        <TextBlock Text="Connected devices" Foreground="{StaticResource Brush.Text}" FontSize="13" Margin="0,14,0,4"/>
        <ListBox x:Name="DeviceList" Height="130" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <Button x:Name="LaunchBtn" Style="{StaticResource PaneButton}" Content="Launch mirror"
                Click="OnLaunch" Margin="0,10,0,0" HorizontalAlignment="Left" IsEnabled="False"/>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource Brush.SubText}" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Looking for scrcpy…"/>

        <CheckBox x:Name="SoftwareRenderCheck" Content="Software rendering (fallback only — enable if the picture shows artifacts)"
                  IsChecked="False" Foreground="{StaticResource Brush.Text}" FontSize="12" Margin="0,14,0,0"/>

        <TextBlock Text="Extra scrcpy arguments (optional, e.g. --max-size 1280)" Foreground="{StaticResource Brush.SubText}"
                   FontSize="12" Margin="0,14,0,4"/>
        <TextBox x:Name="ExtraArgsBox" Width="360" HorizontalAlignment="Left"/>

        <TextBlock Text="scrcpy location (auto-detected, editable)" Foreground="{StaticResource Brush.SubText}"
                   FontSize="12" Margin="0,14,0,4"/>
        <DockPanel Width="480" HorizontalAlignment="Left">
          <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse"/>
          <TextBox x:Name="ScrcpyPathBox"/>
        </DockPanel>

        <TextBlock Text="Wi-Fi mirroring (optional)" Foreground="{StaticResource Brush.Text}" FontSize="13" Margin="0,20,0,4"/>
        <TextBlock Foreground="{StaticResource Brush.SubText}" FontSize="12" TextWrapping="Wrap" LineHeight="19">
          First time: keep USB connected, click "Enable Wi-Fi mode", then unplug. Afterwards enter the phone's IP (Settings → Wi-Fi → network details) and click Connect.
        </TextBlock>
        <DockPanel Width="360" HorizontalAlignment="Left" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Content="Connect" Margin="8,0,0,0" Click="OnWifiConnect"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Content="Enable Wi-Fi mode" Margin="8,0,0,0" Click="OnWifiEnable"/>
          <TextBox x:Name="PhoneIpBox" ToolTip="Phone IP address, e.g. 192.168.1.8"/>
        </DockPanel>

        <Border Background="#202024" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Padding="14,12" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock Text="🎧 Audio on Laptop (Android 9 / Pie):" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" FontSize="13"/>
            <TextBlock Foreground="{StaticResource Brush.SubText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18">
              • <Bold Foreground="{StaticResource Brush.Text}">Why no sound via Bluetooth by default:</Bold> Windows 10/11 pairs your phone as an audio source, but Windows does not route the sound to the laptop speakers without opening the A2DP stream.<LineBreak/>
              • <Bold Foreground="{StaticResource Brush.Text}">How to hear Bluetooth sound:</Bold> Install the free <Bold Foreground="#88C0D0">"Bluetooth Audio Receiver"</Bold> app from Microsoft Store. Open it, select your phone, and click <Bold Foreground="#A3BE8C">"Open Connection"</Bold> — all audio from your phone will immediately play through your laptop speakers with crystal clarity!<LineBreak/>
              • <Bold Foreground="{StaticResource Brush.Text}">Microphone option:</Bold> If you prefer not to use Bluetooth, open the PlayView Stream app on your phone, check "Capture audio via Microphone", and tap Start streaming.
            </TextBlock>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ── Embedded mirror view (Clean VLC-style edge-to-edge canvas) ──── -->
    <Grid x:Name="MirrorPanel" Visibility="Collapsed" Background="Black">
      <lvc:VideoView x:Name="StreamVideo" Visibility="Collapsed" MouseLeftButtonDown="OnStreamGridMouseDown"/>
      <v:MirrorHost x:Name="MirrorHost" Visibility="Collapsed"/>
    </Grid>

  </Grid>

</UserControl>
